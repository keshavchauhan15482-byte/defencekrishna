    "degrade_recoverable_short_network_transport_records": true,
    "audit_keys": [
      "decoded_ipv4",
      "full_tcp",
      "full_udp",
      "degraded_short_ip_options",
      "degraded_short_tcp",
      "degraded_short_udp",
      "nonfirst_fragment",
      "other_protocol",
      "skipped_truncated_ethernet",
      "skipped_truncated_vlan",
      "skipped_truncated_ipv4_header",
      "non_ipv4"
    ]
  },
  "frozen_model_weights_changed": false,
  "frozen_support_gate_changed": false
}
