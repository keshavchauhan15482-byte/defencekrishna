{
  "schema": "garuda-observed-graph-v46-ps-complete",
  "features": [
    "flow_count_log",
    "bytes_log",
    "packets_log",
    "duration_ms_log",
    "syn_fraction",
    "ack_fraction",
    "rst_fraction",
