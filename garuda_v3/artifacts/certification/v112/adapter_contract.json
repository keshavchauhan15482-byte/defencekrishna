    "iat_ms_log",
    "iat_variance_log",
    "iat_max_log",
    "tcp_window_log",
    "ttl_mean_scaled",
    "ttl_variance_scaled",
    "fragment_fraction",
    "payload_mean_log",
    "payload_variance_log",
    "payload_max_log",
    "unique_destination_ports_log",
