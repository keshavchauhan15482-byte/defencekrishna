{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo 'No frontend dependencies required'",
  "buildCommand": "node deployment/vercel/build_site.mjs",
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/",
      "destination": "/console.html"
    },
    {
      "source": "/bridge/live/events",
      "destination": "/api/live-events"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/bridge/live/events",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "includeFiles": "{deployment/vercel/legacy_worker.js,defence-stack-patch.js,detection-engine.js,counter-engine.js,sudarshana-core.js,semantic-feature-extractor.js,behavioral-sequence-model.js,meta-learner-fusion.js,statistical-anomaly-detector.js,sql-tokenizer.js,schema-validator.js,bloom-filter.js,reinforcement-mutation-generator.js}"
    }
  }
}
